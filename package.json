{
  "name": "folio",
  "productName": "Folio",
  "version": "1.0.1",
  "description": "PDF toolkit: merge, organize, split, stamp, optimize, convert, scan",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "Hope Nkuna",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "electron:dev": "vite build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "android:sync": "npm run build && npx cap sync android",
    "prebuild": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capgo/capacitor-document-scanner": "^8.0.0",
    "docx": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@fontsource-variable/inter": "^5.1.0",
    "@capacitor/app": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.hopenkuna.folio",
    "productName": "Folio",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}